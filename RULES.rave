// ====================================================================
// MODULE: EASA Subpart FTL — Regulation (EU) 965/2012 Annex III
// Rules: ORO.FTL.205 / 210 / 235
// ====================================================================


// --------------------------------------------------------------------
// SHARED CONSTANTS
// --------------------------------------------------------------------

CONSTANTS:
  %min_rest_home_floor%    = 12:00;   // ORO.FTL.235(a)
  %min_rest_away_floor%    = 10:00;   // ORO.FTL.235(b)
  %max_duty_7_days%        = 60:00;   // ORO.FTL.210(a)(1)
  %max_duty_14_days%       = 110:00;  // ORO.FTL.210(a)(2)
  %max_duty_28_days%       = 190:00;  // ORO.FTL.210(a)(3)
  %max_block_28_days%      = 100:00;  // ORO.FTL.210(b)(1)
  %max_block_calendar_yr%  = 900:00;  // ORO.FTL.210(b)(2)
  %max_block_12_months%    = 1000:00; // ORO.FTL.210(b)(3)
  %rexrest_min_duration%   = 36:00;   // ORO.FTL.235(d)
  %rexrest_max_interval%   = 168:00;  // ORO.FTL.235(d)
ENDCONSTANTS


// --------------------------------------------------------------------
// SHARED DUTY-LEVEL HELPERS
// --------------------------------------------------------------------

%number_of_sectors%   = count(leg(duty));
%block_time%          = sum(leg(duty), leg.%on_block_utc% - leg.%off_block_utc%);
%flight_duty_period%  = last(leg(duty), leg.%on_block_utc%) - duty.%report_utc%;
%duty_time%           = duty.%release_utc% - duty.%report_utc%;
%starts_at_home_base% = first(leg(duty), leg.%dep_airport%) = duty.%home_base%;

// Rest before this duty and the duty time of the one before it
%rest_before%         = duty.%report_utc% - prev(duty(roster), duty.%release_utc%);
%preceding_duty_time% = prev(duty(roster), %duty_time%);


// ====================================================================
// RULE 1 — Basic maximum daily FDP
// ORO.FTL.205(b), Table 2
// Duty level. Final rule — monotonic FDP vs constant bound.
// Table 2 is an etable keyed by (local_report_time_band, sector_count).
// The midnight-wraparound band (17:00–04:59) is encoded in the etable
// rows, not in rule logic.
// ====================================================================

%max_fdp% =
    table("easa_fdp_table_2").lookup(
        duty.%local_report_time%,
        %number_of_sectors%,
        "max_fdp"
    );

CONSTRAINT max_daily_fdp OF Duty
    COMMENT: "FDP must not exceed ORO.FTL.205(b) Table 2 for local report time and sector count."
    STATUS: ON;
    RULE:
        %flight_duty_period% <= %max_fdp%;
ENDCONSTRAINT


// ====================================================================
// RULE 2 — Maximum daily FDP, unknown acclimatisation
// ORO.FTL.205(b)(2), Table 3
// STATUS: OFF — roster model treats all crew as acclimatised.
// The constraint is declared so the hook exists; it is never active.
// ====================================================================

CONSTRAINT max_daily_fdp_unknown_acclimatisation OF Duty
    COMMENT: "Table 3 applies only when acclimatisation state is unknown. Not active in this model."
    STATUS: OFF;
    RULE:
        True;
ENDCONSTRAINT


// ====================================================================
// RULES 3–6 — Rolling duty and block windows
// ORO.FTL.210(a)(1–3) and 210(b)(1)
// Roster level. roster_window_Nd is a half-open sliding-window
// traverser anchored at each duty's report time, equivalent to the
// polars rolling() with closed="left". A calendar-week sum passes
// illegal_rolling_7day; this sliding window catches it.
// ====================================================================

CONSTRAINT max_duty_in_7_days OF Roster
    COMMENT: "Total duty must not exceed 60:00 in any 7 consecutive days."
    STATUS: ON;
    RULE:
        all(duty(roster),
            sum(duty(roster_window_7d), %duty_time%) <= %max_duty_7_days%
        );
ENDCONSTRAINT

CONSTRAINT max_duty_in_14_days OF Roster
    COMMENT: "Total duty must not exceed 110:00 in any 14 consecutive days."
    STATUS: ON;
    RULE:
        all(duty(roster),
            sum(duty(roster_window_14d), %duty_time%) <= %max_duty_14_days%
        );
ENDCONSTRAINT

CONSTRAINT max_duty_in_28_days OF Roster
    COMMENT: "Total duty must not exceed 190:00 in any 28 consecutive days."
    STATUS: ON;
    RULE:
        all(duty(roster),
            sum(duty(roster_window_28d), %duty_time%) <= %max_duty_28_days%
        );
ENDCONSTRAINT

CONSTRAINT max_block_in_28_days OF Roster
    COMMENT: "Total block time must not exceed 100:00 in any 28 consecutive days."
    STATUS: ON;
    RULE:
        all(duty(roster),
            sum(duty(roster_window_28d), %block_time%) <= %max_block_28_days%
        );
ENDCONSTRAINT


// ====================================================================
// RULE 7 — Maximum block time in a calendar year
// ORO.FTL.210(b)(2)
// roster_same_year aggregates all duties sharing the same UTC year as
// the anchor duty.
// ====================================================================

CONSTRAINT max_block_calendar_year OF Roster
    COMMENT: "Total block time must not exceed 900:00 in any calendar year."
    STATUS: ON;
    RULE:
        all(duty(roster),
            sum(duty(roster_same_year), %block_time%) <= %max_block_calendar_yr%
        );
ENDCONSTRAINT


// ====================================================================
// RULE 8 — Maximum block time in 12 consecutive months
// ORO.FTL.210(b)(3)
// roster_window_12m is a month-aligned 12-month sliding window.
// ====================================================================

CONSTRAINT max_block_in_12_months OF Roster
    COMMENT: "Total block time must not exceed 1000:00 in any 12 consecutive calendar months."
    STATUS: ON;
    RULE:
        all(duty(roster),
            sum(duty(roster_window_12m), %block_time%) <= %max_block_12_months%
        );
ENDCONSTRAINT


// ====================================================================
// RULES 9–10 — Minimum rest at home base and away from home base
// ORO.FTL.235(a)/(b)
// Duty level — each duty checks its own preceding rest.
// Condition-Guard pattern: valid skips the rule for inapplicable
// duties rather than forcing it to evaluate True for them.
// valid ... <> void guards the first duty (no preceding duty exists).
// ====================================================================

%min_rest_home_required% =
    if %preceding_duty_time% > %min_rest_home_floor% then
        %preceding_duty_time%
    else
        %min_rest_home_floor%;

CONSTRAINT min_rest_home_base OF Duty
    COMMENT: "Rest before a home-base FDP must be >= preceding duty period or 12:00, whichever greater."
    STATUS: ON;
    RULE:
        valid %starts_at_home_base%;
        valid prev(duty(roster), duty.%release_utc%) <> void;
        %rest_before% >= %min_rest_home_required%;
ENDCONSTRAINT

%min_rest_away_required% =
    if %preceding_duty_time% > %min_rest_away_floor% then
        %preceding_duty_time%
    else
        %min_rest_away_floor%;

CONSTRAINT min_rest_away_base OF Duty
    COMMENT: "Rest before an away-base FDP must be >= preceding duty period or 10:00, whichever greater."
    STATUS: ON;
    RULE:
        valid not %starts_at_home_base%;
        valid prev(duty(roster), duty.%release_utc%) <> void;
        %rest_before% >= %min_rest_away_required%;
ENDCONSTRAINT


// ====================================================================
// RULE 11 — Recurrent extended recovery rest
// ORO.FTL.235(d)
// Two sub-checks:
//   (a) Duration: a rest spanning 2+ local nights must be >= 36:00.
//   (b) Interval: gap between consecutive qualifying rests <= 168:00.
//
// local_nights is an etable (or solver keyword) that counts how many
// 22:00–08:00 local windows fall fully inside a rest period, using
// the base timezone. This is the DST-sensitive calculation —
// illegal_rexrest_dst exists because a fixed UTC offset gets it wrong
// across the spring-forward change.
//
// %prev_rexrest_end% is a recursive carry-forward: the standard RAVE
// pattern for "timestamp of the most recent event of type X."
//
// valid is_closed on the interval check is the Illegal Subchain
// pattern — the gap can only be assessed on a complete roster.
// ====================================================================

%local_nights_in_rest% =
    table("local_nights").lookup(
        prev(duty(roster), duty.%release_utc%),
        duty.%report_utc%,
        duty.%base_tz%,
        "night_count"
    );

%is_qualifying_rexrest% =
    %rest_before% >= %rexrest_min_duration% and
    %local_nights_in_rest% >= 2;

// (a) Duration check
CONSTRAINT rexrest_min_duration OF Duty
    COMMENT: "An extended recovery rest spanning 2+ local nights must be at least 36:00."
    STATUS: ON;
    RULE:
        valid %local_nights_in_rest% >= 2;
        %rest_before% >= %rexrest_min_duration%;
ENDCONSTRAINT

// Carry the end-time of the most recent qualifying rest forward across duties
%prev_rexrest_end% =
    if prev(duty(roster), %is_qualifying_rexrest%) then
        prev(duty(roster), duty.%report_utc%)
    else
        prev(duty(roster), %prev_rexrest_end%);

// (b) Interval check
CONSTRAINT rexrest_max_interval OF Roster
    COMMENT: "Gap between consecutive extended recovery rests must not exceed 168:00."
    STATUS: ON;
    RULE:
        valid is_closed;
        all(duty(roster),
            valid %is_qualifying_rexrest%;
            duty.%report_utc% - %prev_rexrest_end% <= %rexrest_max_interval%
        );
ENDCONSTRAINT


// ====================================================================
// CBA OVERLAY EXAMPLE — Operator A pilot CBA
// In a real Jeppesen environment these live in a separate module that
// overrides the base constants. The parameter bounds enforce the
// same invariant as Python's SchemeError: a CBA cannot widen a
// regulatory limit, only tighten it.
// ====================================================================

// %min_rest_home_floor% = parameter 14:00 minvalue 12:00 maxvalue 14:00;  // CBA §7.2
// %max_duty_7_days%     = parameter 55:00 minvalue 00:00 maxvalue 60:00;  // CBA §9.1
